# Copia questo file in .env.local e compila i valori

# ── Sviluppo locale ────────────────────────────────────────────────────────────
# Redis locale via Docker Compose: docker compose up -d redis
# Lascia vuoto per usare il fallback in-memory (nessun multiplayer persistente)
REDIS_URL=redis://localhost:6379

# ── Segreti (in produzione: Vercel → Settings → Environment Variables) ────────
# Mai nel repository né nel README. Per generarne uno: openssl rand -base64 18

# Accesso a GET /api/feedback (es. curl .../api/feedback?secret=xxx)
FEEDBACK_SECRET=cambia-questo-valore

# Pagina educatori /educatore/codice, che genera i codici monouso per le partite
# con foto e video FACES. Senza questa variabile nessuno può generare codici.
FACES_CODES_SECRET=cambia-questo-valore

# ── Produzione (Vercel KV) ─────────────────────────────────────────────────────
# Forniti automaticamente da Vercel quando si collega un KV store.
# Non servono in sviluppo locale se REDIS_URL è impostato.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ── Fotografie FACES ───────────────────────────────────────────────────────────
# Produzione: archivio Vercel Blob privato (fornito da Vercel quando si collega
# il Blob store). Caricamento: node scripts/upload-faces-to-blob.mjs <cartella>
# BLOB_READ_WRITE_TOKEN=
#
# Sviluppo locale: FACES_LOCAL_DIR=/percorso/alle/foto, ma NON in questo file:
# impostala solo da shell (FACES_LOCAL_DIR=... npm run dev), altrimenti i test
# e2e in Docker fotograferebbero le foto vere.
# Senza nessuna delle due, al posto delle foto compare un segnaposto.
